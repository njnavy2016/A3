# ---- MySQL ----
MYSQL_ROOT_PASSWORD=pdm_root_2026
MYSQL_DATABASE=pdm_system
MYSQL_USER=pdm_user
MYSQL_PASSWORD=pdm_pass_2026

# ---- MinIO ----
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin2026

# ---- LLM（智能体推理用）----
# 支持 DeepSeek / OpenAI / 兼容 OpenAI API 的服务
LLM_API_KEY=sk-your-llm-api-key-here
